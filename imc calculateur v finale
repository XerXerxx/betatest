<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Calculateur IMC Annette</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >
</head>

<body style="margin:0; background:#ffffff;">

<div class="annette-imc-widget">
  <style>
    .annette-imc-widget,
    .annette-imc-modal {
      --ink: #0f0f0e;
      --muted: #4a4a4a;
      --blue: #a9e1ff;
      --light-blue: #dff2ff;
      --cream: #fefbf9;
      --yellow: #ffd973;
      --pink: #ffd5fb;
      --peach: #ffc89a;
      --white: #ffffff;
      --stars: #ef9f27;

      color: var(--ink);
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .annette-imc-widget *,
    .annette-imc-widget *::before,
    .annette-imc-widget *::after,
    .annette-imc-modal *,
    .annette-imc-modal *::before,
    .annette-imc-modal *::after {
      box-sizing: border-box;
    }

    .annette-imc-widget {
      display: flex;
      justify-content: center;

      width: 100%;
      padding: 24px 16px;
    }

    /* =========================
       CARTE DU CALCULATEUR
    ========================= */

    .annette-imc-widget .imc-card {
      width: 100%;
      max-width: 480px;
      padding: 32px;

      overflow: hidden;

      background: var(--blue);
      border-radius: 24px;
      box-shadow: 0 12px 36px rgba(15, 15, 14, 0.08);

      opacity: 0;
      transform: translateY(24px) scale(0.985);

      transition:
        opacity 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
        transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .annette-imc-widget .imc-card.is-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    /* =========================
       BULLES
    ========================= */

    .annette-imc-widget .imc-bubbles {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: repeat(2, auto);
      align-items: center;

      width: 100%;
      min-height: 100px;
      margin: 0 auto 14px;
      gap: 10px 6px;
    }

    .annette-imc-widget .imc-bubble {
      --rotation: 0deg;
      --offset: -5px;
      --delay: 0s;

      display: inline-flex;
      align-items: center;
      justify-content: center;
      justify-self: center;

      min-height: 36px;
      padding: 8px 14px;

      color: var(--ink);
      background: var(--cream);
      border: 1.5px solid var(--ink);
      border-radius: 999px;
      box-shadow: 0 4px 0 rgba(15, 15, 14, 0.08);

      font-size: 12px;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;

      pointer-events: none;

      animation: annetteImcFloat 4.8s ease-in-out infinite;
      animation-delay: var(--delay);
    }

    .annette-imc-widget .imc-bubble::before {
      width: 7px;
      height: 7px;
      margin-right: 7px;

      content: "";

      background: var(--ink);
      border-radius: 50%;
      opacity: 0.8;
    }

    .annette-imc-widget .bubble-height {
      grid-column: 1 / 3;
      grid-row: 1;

      --rotation: -3deg;
      --offset: -4px;
      --delay: -0.5s;
    }

    .annette-imc-widget .bubble-weight {
      grid-column: 3 / 5;
      grid-row: 1;

      --rotation: 2deg;
      --offset: -6px;
      --delay: -1.8s;

      background: var(--yellow);
    }

    .annette-imc-widget .bubble-imc {
      grid-column: 5 / 7;
      grid-row: 1;

      --rotation: -2deg;
      --offset: -4px;
      --delay: -2.7s;

      background: var(--pink);
    }

    .annette-imc-widget .bubble-marker {
      grid-column: 2 / 4;
      grid-row: 2;

      --rotation: 2deg;
      --offset: -5px;
      --delay: -1.2s;

      background: var(--white);
    }

    .annette-imc-widget .bubble-support {
      grid-column: 4 / 6;
      grid-row: 2;

      --rotation: -2deg;
      --offset: -5px;
      --delay: -3.2s;
    }

    @keyframes annetteImcFloat {
      0%,
      100% {
        transform: translateY(0) rotate(var(--rotation));
      }

      50% {
        transform: translateY(var(--offset)) rotate(var(--rotation));
      }
    }

    /* =========================
       TITRES
    ========================= */

    .annette-imc-widget .imc-title {
      max-width: 400px;
      margin: 0 auto 12px;

      font-size: 28px;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.03em;
      text-align: center;
    }

    .annette-imc-widget .imc-intro {
      max-width: 390px;
      margin: 0 auto 28px;

      color: var(--muted);

      font-size: 16px;
      line-height: 1.55;
      text-align: center;
    }

    /* =========================
       FORMULAIRE
    ========================= */

    .annette-imc-widget .imc-form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;

      margin-bottom: 16px;
    }

    .annette-imc-widget .imc-label {
      display: block;

      margin-bottom: 8px;

      font-size: 14px;
      font-weight: 600;
    }

    .annette-imc-widget .imc-input-wrap {
      position: relative;
    }

    .annette-imc-widget .imc-input {
      width: 100%;
      height: 58px;
      padding: 0 52px 0 16px;

      color: var(--ink);
      background: var(--cream);
      border: 2px solid transparent;
      border-radius: 15px;
      outline: none;
      box-shadow: 0 2px 8px rgba(15, 15, 14, 0.04);

      font-family: inherit;
      font-size: 18px;
      font-weight: 600;

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        opacity 0.2s ease;
    }

    .annette-imc-widget .imc-input::placeholder {
      color: #8a8a8a;
      font-weight: 500;
    }

    .annette-imc-widget .imc-input:focus {
      border-color: var(--ink);
      box-shadow: 0 0 0 3px rgba(15, 15, 14, 0.1);
    }

    .annette-imc-widget .imc-input:disabled {
      cursor: wait;
      opacity: 0.7;
    }

    .annette-imc-widget .imc-unit {
      position: absolute;
      top: 50%;
      right: 16px;

      color: var(--muted);

      font-size: 14px;
      font-weight: 600;

      pointer-events: none;

      transform: translateY(-50%);
    }

    .annette-imc-widget .imc-error {
      display: none;

      margin: 0 0 16px;
      padding: 12px 14px;

      background: var(--pink);
      border: 1.5px solid var(--ink);
      border-radius: 12px;

      font-size: 13px;
      font-weight: 500;
      line-height: 1.4;
    }

    .annette-imc-widget .imc-error.is-visible {
      display: block;
    }

    /* =========================
       BOUTONS
    ========================= */

    .annette-imc-widget .imc-button,
    .annette-imc-modal .imc-button {
      width: 100%;
      min-height: 54px;
      padding: 16px 18px;

      color: var(--cream);
      background: var(--ink);
      border: none;
      border-radius: 16px;
      box-shadow: 0 4px 12px rgba(15, 15, 14, 0.15);

      font-family: inherit;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.2;

      cursor: pointer;

      transition:
        transform 0.2s ease,
        opacity 0.2s ease;
    }

    .annette-imc-widget .imc-button:hover,
    .annette-imc-modal .imc-button:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }

    .annette-imc-widget .imc-button:disabled {
      cursor: wait;
      opacity: 1;
      transform: none;
    }

    .annette-imc-widget .imc-button-content {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .annette-imc-widget .imc-spinner {
      display: none;

      width: 18px;
      height: 18px;

      border: 2px solid rgba(254, 251, 249, 0.35);
      border-top-color: var(--cream);
      border-radius: 50%;

      animation: annetteImcSpin 0.75s linear infinite;
    }

    .annette-imc-widget .imc-button.is-calculating .imc-spinner {
      display: inline-block;
    }

    @keyframes annetteImcSpin {
      to {
        transform: rotate(360deg);
      }
    }

    /* =========================
       ANIMATION DU CALCUL
    ========================= */

    .annette-imc-widget .imc-calculation-status {
      display: none;

      margin-top: 14px;
      padding: 13px;

      background: rgba(254, 251, 249, 0.72);
      border: 1px solid rgba(15, 15, 14, 0.13);
      border-radius: 14px;

      opacity: 0;
      transform: translateY(6px);
    }

    .annette-imc-widget .imc-calculation-status.is-visible {
      display: block;

      animation: annetteCalculationIn 0.25s ease forwards;
    }

    @keyframes annetteCalculationIn {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .annette-imc-widget .imc-calculation-row {
      display: flex;
      align-items: center;
      gap: 9px;

      margin-bottom: 9px;
    }

    .annette-imc-widget .imc-calculation-icon {
      position: relative;

      flex: 0 0 auto;

      width: 17px;
      height: 17px;

      border: 1.5px solid var(--ink);
      border-radius: 50%;

      animation: annetteCalculationPulse 1s ease-in-out infinite;
    }

    .annette-imc-widget .imc-calculation-icon::after {
      position: absolute;
      top: 50%;
      left: 50%;

      width: 5px;
      height: 5px;

      content: "";

      background: var(--ink);
      border-radius: 50%;

      transform: translate(-50%, -50%);
    }

    @keyframes annetteCalculationPulse {
      0%,
      100% {
        opacity: 0.55;
        transform: scale(0.9);
      }

      50% {
        opacity: 1;
        transform: scale(1);
      }
    }

    .annette-imc-widget .imc-calculation-text {
      margin: 0;

      font-size: 13px;
      font-weight: 600;
    }

    .annette-imc-widget .imc-calculation-track {
      width: 100%;
      height: 7px;

      overflow: hidden;

      background: rgba(15, 15, 14, 0.12);
      border-radius: 999px;
    }

    .annette-imc-widget .imc-calculation-progress {
      width: 8%;
      height: 100%;

      background: var(--ink);
      border-radius: 999px;

      transition: width 0.4s ease;
    }

    .annette-imc-widget .imc-privacy {
      margin: 14px 0 0;

      color: var(--muted);

      font-size: 12px;
      line-height: 1.45;
      text-align: center;
    }

    /* =========================
       POP-UP
    ========================= */

    .annette-imc-modal {
      position: fixed;
      inset: 0;
      z-index: 2147483647;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 16px;

      visibility: hidden;
      background: rgba(15, 15, 14, 0.58);
      opacity: 0;

      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);

      transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
    }

    .annette-imc-modal.is-open {
      visibility: visible;
      opacity: 1;
    }

    .annette-imc-modal .imc-modal-dialog {
      position: relative;

      width: 100%;
      max-width: 500px;
      max-height: calc(100dvh - 32px);
      padding: 22px;

      overflow-y: auto;
      overscroll-behavior: contain;

      background: var(--blue);
      border: 1.5px solid rgba(15, 15, 14, 0.18);
      border-radius: 22px;
      box-shadow: 0 24px 70px rgba(15, 15, 14, 0.24);

      opacity: 0;
      transform: translateY(18px) scale(0.98);

      transition:
        opacity 0.3s ease,
        transform 0.3s ease;
    }

    .annette-imc-modal.is-open .imc-modal-dialog {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .annette-imc-modal .imc-modal-close {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 5;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 36px;
      height: 36px;
      padding: 0;

      color: var(--ink);
      background: rgba(254, 251, 249, 0.94);
      border: 1px solid rgba(15, 15, 14, 0.16);
      border-radius: 50%;

      cursor: pointer;
    }

    /* =========================
       RÉSULTAT
    ========================= */

    .annette-imc-modal .imc-result-summary {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      align-items: center;
      gap: 15px;

      margin-bottom: 13px;
      padding-right: 28px;
    }

    .annette-imc-modal .imc-circle-indicator {
      position: relative;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 112px;
      height: 112px;
    }

    .annette-imc-modal .imc-circle-indicator svg {
      position: absolute;
      inset: 0;

      width: 100%;
      height: 100%;

      transform: rotate(-90deg);
    }

    .annette-imc-modal .imc-circle-track {
      fill: none;
      stroke: rgba(15, 15, 14, 0.12);
      stroke-width: 9;
    }

    .annette-imc-modal .imc-circle-segment {
      fill: none;
      stroke: rgba(15, 15, 14, 0.14);
      stroke-width: 9;
      stroke-linecap: round;
    }

    .annette-imc-modal .imc-circle-segment.active.class-1 {
      stroke: var(--yellow);
    }

    .annette-imc-modal .imc-circle-segment.active.class-2 {
      stroke: var(--peach);
    }

    .annette-imc-modal .imc-circle-segment.active.class-3 {
      stroke: var(--pink);
    }

    .annette-imc-modal .imc-circle-center {
      position: relative;
      z-index: 2;

      text-align: center;
    }

    .annette-imc-modal .imc-result-label {
      display: block;

      margin-bottom: 2px;

      font-size: 8px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .annette-imc-modal .imc-result-value {
      display: block;

      font-size: 28px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .annette-imc-modal .imc-result-unit {
      display: block;

      margin-top: 3px;

      font-size: 9px;
      font-weight: 600;
    }

    .annette-imc-modal .imc-class-badge {
      display: inline-flex;
      align-items: center;

      margin-bottom: 7px;
      padding: 6px 9px;

      color: var(--ink);
      border: 1.5px solid var(--ink);
      border-radius: 999px;
      box-shadow: 0 3px 0 rgba(15, 15, 14, 0.07);

      font-size: 10px;
      font-weight: 700;
      line-height: 1.2;
    }

    .annette-imc-modal .imc-class-badge.class-1 {
      background: var(--yellow);
    }

    .annette-imc-modal .imc-class-badge.class-2 {
      background: var(--peach);
    }

    .annette-imc-modal .imc-class-badge.class-3 {
      background: var(--pink);
    }

    .annette-imc-modal .imc-result-title {
      margin: 0 0 4px;

      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: -0.02em;
    }

    .annette-imc-modal .imc-result-text {
      margin: 0;

      color: var(--muted);

      font-size: 12px;
      line-height: 1.4;
    }

    /* =========================
       AVANTAGES COMPACTS
    ========================= */

    .annette-imc-modal .imc-benefits-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;

      margin-bottom: 10px;
      padding: 10px;

      background: var(--light-blue);
      border: 1px solid rgba(15, 15, 14, 0.11);
      border-radius: 14px;
    }

    .annette-imc-modal .imc-benefit {
      display: flex;
      align-items: center;
      gap: 7px;

      min-width: 0;
      padding: 5px;
    }

    .annette-imc-modal .imc-benefit-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;

      width: 25px;
      height: 25px;

      background: rgba(255, 255, 255, 0.88);
      border: 1px solid rgba(15, 15, 14, 0.14);
      border-radius: 8px;
    }

    .annette-imc-modal .imc-benefit p {
      margin: 0;

      font-size: 11px;
      font-weight: 600;
      line-height: 1.25;
    }

    /* =========================
       GOOGLE
    ========================= */

    .annette-imc-modal .imc-google {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;

      margin-bottom: 10px;
      padding: 9px 10px;

      background: var(--cream);
      border: 1px solid rgba(15, 15, 14, 0.1);
      border-radius: 12px;
    }

    .annette-imc-modal .imc-google-stars {
      color: var(--stars);

      font-size: 13px;
      line-height: 1;
      letter-spacing: 0.5px;
      white-space: nowrap;
    }

    .annette-imc-modal .imc-google-text {
      color: var(--muted);

      font-size: 10.5px;
      font-weight: 600;
      line-height: 1.25;
      text-align: center;
    }

    /* =========================
       BAS DE LA POP-UP
    ========================= */

    .annette-imc-modal .imc-modal-reassure {
      margin: 8px 0 0;

      color: var(--muted);

      font-size: 10.5px;
      font-weight: 600;
      text-align: center;
    }

    .annette-imc-modal .imc-edit-button {
      display: block;

      margin: 2px auto 0;
      padding: 7px 10px;

      color: var(--ink);
      background: transparent;
      border: none;

      font-family: inherit;
      font-size: 10.5px;
      font-weight: 600;

      cursor: pointer;
    }

    .annette-imc-modal .imc-edit-button:hover {
      text-decoration: underline;
    }

    .annette-imc-modal .imc-disclaimer {
      margin: 3px 0 0;

      color: var(--muted);

      font-size: 8.5px;
      line-height: 1.35;
      text-align: center;
    }

    .annette-imc-modal .imc-info-box {
      margin-bottom: 10px;
      padding: 12px;

      background: var(--light-blue);
      border-radius: 13px;

      font-size: 12px;
      line-height: 1.4;
      text-align: center;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 479px) {
      .annette-imc-widget {
        padding: 18px 12px;
      }

      .annette-imc-widget .imc-card {
        padding: 24px;
        border-radius: 20px;
      }

      .annette-imc-widget .imc-title {
        font-size: 25px;
      }

      .annette-imc-widget .imc-intro {
        margin-bottom: 22px;

        font-size: 15px;
      }

      .annette-imc-widget .imc-bubbles {
        min-height: 92px;
        gap: 8px 3px;
      }

      .annette-imc-widget .imc-bubble {
        min-height: 32px;
        padding: 7px 9px;

        font-size: 10px;
      }

      .annette-imc-widget .imc-bubble::before {
        width: 6px;
        height: 6px;
        margin-right: 5px;
      }

      .annette-imc-widget .imc-form-grid {
        grid-template-columns: 1fr;
      }

      .annette-imc-modal {
        padding:
          max(8px, env(safe-area-inset-top))
          8px
          max(8px, env(safe-area-inset-bottom));
      }

      .annette-imc-modal .imc-modal-dialog {
        max-height: calc(
          100dvh -
          max(16px, env(safe-area-inset-top)) -
          max(16px, env(safe-area-inset-bottom))
        );

        padding: 16px;

        border-radius: 18px;
      }

      .annette-imc-modal .imc-modal-close {
        top: 8px;
        right: 8px;

        width: 32px;
        height: 32px;
      }

      .annette-imc-modal .imc-result-summary {
        grid-template-columns: 88px minmax(0, 1fr);
        gap: 10px;

        margin-bottom: 9px;
        padding-right: 20px;
      }

      .annette-imc-modal .imc-circle-indicator {
        width: 88px;
        height: 88px;
      }

      .annette-imc-modal .imc-result-value {
        font-size: 24px;
      }

      .annette-imc-modal .imc-result-label {
        font-size: 7px;
      }

      .annette-imc-modal .imc-result-unit {
        font-size: 8px;
      }

      .annette-imc-modal .imc-class-badge {
        margin-bottom: 5px;
        padding: 5px 8px;

        font-size: 9px;
      }

      .annette-imc-modal .imc-result-title {
        font-size: 13px;
      }

      .annette-imc-modal .imc-result-text {
        font-size: 10.5px;
      }

      .annette-imc-modal .imc-benefits-box {
        gap: 4px;

        margin-bottom: 8px;
        padding: 7px;
      }

      .annette-imc-modal .imc-benefit {
        gap: 5px;
        padding: 4px;
      }

      .annette-imc-modal .imc-benefit-icon {
        width: 23px;
        height: 23px;
      }

      .annette-imc-modal .imc-benefit p {
        font-size: 9.5px;
      }

      .annette-imc-modal .imc-google {
        margin-bottom: 8px;
        padding: 7px 8px;
      }

      .annette-imc-modal .imc-google-stars {
        font-size: 12px;
      }

      .annette-imc-modal .imc-google-text {
        font-size: 9.5px;
      }

      .annette-imc-modal .imc-button {
        min-height: 48px;
        padding: 13px 15px;

        border-radius: 14px;

        font-size: 14px;
      }
    }

    @media (max-width: 340px) {
      .annette-imc-modal .imc-benefits-box {
        grid-template-columns: 1fr;
      }

      .annette-imc-modal .imc-result-summary {
        grid-template-columns: 78px minmax(0, 1fr);
      }

      .annette-imc-modal .imc-circle-indicator {
        width: 78px;
        height: 78px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .annette-imc-widget .imc-card,
      .annette-imc-widget .imc-bubble,
      .annette-imc-widget .imc-spinner,
      .annette-imc-widget .imc-calculation-icon,
      .annette-imc-modal,
      .annette-imc-modal .imc-modal-dialog {
        animation: none !important;
        transition-duration: 0.01ms !important;
      }

      .annette-imc-widget .imc-card {
        opacity: 1;
        transform: none;
      }
    }
  </style>

  <!-- CALCULATEUR -->

  <div class="imc-card" id="annette-imc-card">
    <div class="imc-bubbles" aria-hidden="true">
      <div class="imc-bubble bubble-height">Taille</div>
      <div class="imc-bubble bubble-weight">Poids</div>
      <div class="imc-bubble bubble-imc">IMC</div>
      <div class="imc-bubble bubble-marker">Repère</div>
      <div class="imc-bubble bubble-support">Accompagnement</div>
    </div>

    <h2 class="imc-title">
      Calculez votre IMC en quelques secondes
    </h2>

    <p class="imc-intro">
      Indiquez votre taille et votre poids pour obtenir une estimation
      de votre indice de masse corporelle.
    </p>

    <form id="annette-imc-form" novalidate>
      <div class="imc-form-grid">
        <div>
          <label class="imc-label" for="annette-imc-height">
            Votre taille
          </label>

          <div class="imc-input-wrap">
            <input
              class="imc-input"
              id="annette-imc-height"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              placeholder="Ex. 168"
              aria-describedby="annette-imc-error"
            >

            <span class="imc-unit">cm</span>
          </div>
        </div>

        <div>
          <label class="imc-label" for="annette-imc-weight">
            Votre poids
          </label>

          <div class="imc-input-wrap">
            <input
              class="imc-input"
              id="annette-imc-weight"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              placeholder="Ex. 85"
              aria-describedby="annette-imc-error"
            >

            <span class="imc-unit">kg</span>
          </div>
        </div>
      </div>

      <div
        class="imc-error"
        id="annette-imc-error"
        role="alert"
      ></div>

      <button
        class="imc-button"
        id="annette-imc-submit"
        type="submit"
      >
        <span class="imc-button-content">
          <span class="imc-spinner" aria-hidden="true"></span>

          <span id="annette-imc-button-text">
            Calculer mon IMC →
          </span>
        </span>
      </button>

      <div
        class="imc-calculation-status"
        id="annette-imc-calculation-status"
        aria-live="polite"
        aria-hidden="true"
      >
        <div class="imc-calculation-row">
          <span
            class="imc-calculation-icon"
            aria-hidden="true"
          ></span>

          <p
            class="imc-calculation-text"
            id="annette-imc-calculation-text"
          >
            Vérification de vos informations…
          </p>
        </div>

        <div class="imc-calculation-track" aria-hidden="true">
          <div
            class="imc-calculation-progress"
            id="annette-imc-calculation-progress"
          ></div>
        </div>
      </div>
    </form>

    <p class="imc-privacy">
      Calcul indicatif réservé aux adultes. Les valeurs saisies restent
      dans votre navigateur et ne sont pas enregistrées.
    </p>
  </div>

  <!-- POP-UP DU RÉSULTAT -->

  <div
    class="annette-imc-modal"
    id="annette-imc-modal"
    aria-hidden="true"
  >
    <div
      class="imc-modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="annette-imc-result-title"
    >
      <button
        class="imc-modal-close"
        id="annette-imc-modal-close"
        type="button"
        aria-label="Fermer la fenêtre"
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>

      <div id="annette-imc-modal-content"></div>
    </div>
  </div>

  <script>
    (function () {
      var card = document.getElementById("annette-imc-card");
      var form = document.getElementById("annette-imc-form");

      var heightInput = document.getElementById(
        "annette-imc-height"
      );

      var weightInput = document.getElementById(
        "annette-imc-weight"
      );

      var errorBox = document.getElementById(
        "annette-imc-error"
      );

      var submitButton = document.getElementById(
        "annette-imc-submit"
      );

      var buttonText = document.getElementById(
        "annette-imc-button-text"
      );

      var calculationStatus = document.getElementById(
        "annette-imc-calculation-status"
      );

      var calculationText = document.getElementById(
        "annette-imc-calculation-text"
      );

      var calculationProgress = document.getElementById(
        "annette-imc-calculation-progress"
      );

      var modal = document.getElementById(
        "annette-imc-modal"
      );

      var modalContent = document.getElementById(
        "annette-imc-modal-content"
      );

      var closeButton = document.getElementById(
        "annette-imc-modal-close"
      );

      var lastFocusedElement = null;
      var calculationTimers = [];

      if (modal.parentNode !== document.body) {
        document.body.appendChild(modal);
      }

      function showCard() {
        card.classList.add("is-visible");
      }

      if ("IntersectionObserver" in window) {
        var observer = new IntersectionObserver(
          function (entries) {
            if (entries[0].isIntersecting) {
              showCard();
              observer.disconnect();
            }
          },
          {
            threshold: 0.2
          }
        );

        observer.observe(card);
      } else {
        showCard();
      }

      function normalizeNumber(value) {
        return parseFloat(
          String(value)
            .trim()
            .replace(",", ".")
            .replace(/\s/g, "")
        );
      }

      function calculateImc(weight, heightCm) {
        var heightMeters = heightCm / 100;

        return weight / (heightMeters * heightMeters);
      }

      function formatImc(value) {
        return value.toFixed(1).replace(".", ",");
      }

      function showError(message, input) {
        errorBox.textContent = message;
        errorBox.classList.add("is-visible");

        if (input) {
          input.focus();
        }
      }

      function clearError() {
        errorBox.textContent = "";
        errorBox.classList.remove("is-visible");
      }

      function clearCalculationTimers() {
        calculationTimers.forEach(function (timer) {
          window.clearTimeout(timer);
        });

        calculationTimers = [];
      }

      function setCalculationState(active) {
        heightInput.disabled = active;
        weightInput.disabled = active;
        submitButton.disabled = active;

        if (active) {
          submitButton.classList.add("is-calculating");
          buttonText.textContent = "Calcul de votre IMC…";

          calculationStatus.classList.add("is-visible");
          calculationStatus.setAttribute("aria-hidden", "false");
        } else {
          submitButton.classList.remove("is-calculating");
          buttonText.textContent = "Calculer mon IMC →";

          calculationStatus.classList.remove("is-visible");
          calculationStatus.setAttribute("aria-hidden", "true");

          calculationText.textContent =
            "Vérification de vos informations…";

          calculationProgress.style.width = "8%";

          heightInput.disabled = false;
          weightInput.disabled = false;
          submitButton.disabled = false;
        }
      }

      function startCalculation(imc) {
        clearCalculationTimers();
        setCalculationState(true);

        calculationText.textContent =
          "Vérification de vos informations…";

        calculationProgress.style.width = "12%";

        calculationTimers.push(
          window.setTimeout(function () {
            calculationText.textContent =
              "Application de la formule…";

            calculationProgress.style.width = "48%";
          }, 400)
        );

        calculationTimers.push(
          window.setTimeout(function () {
            calculationText.textContent =
              "Préparation du résultat…";

            calculationProgress.style.width = "82%";
          }, 850)
        );

        calculationTimers.push(
          window.setTimeout(function () {
            calculationProgress.style.width = "100%";
          }, 1180)
        );

        calculationTimers.push(
          window.setTimeout(function () {
            setCalculationState(false);
            renderResult(imc);
          }, 1420)
        );
      }

      function openModal() {
        lastFocusedElement = document.activeElement;

        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");

        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";

        window.setTimeout(function () {
          closeButton.focus();
        }, 50);
      }

      function closeModal() {
        modal.classList.remove("is-open");
        modal.setAttribute("aria-hidden", "true");

        document.documentElement.style.overflow = "";
        document.body.style.overflow = "";

        if (lastFocusedElement) {
          lastFocusedElement.focus();
        }
      }

      function getImcClassData(imc) {
        if (imc >= 40) {
          return {
            classKey: "class-3",
            classIndex: 3,
            badge: "Obésité de classe III",
            title:
              "Une perte de poids progressive peut apporter des bénéfices importants.",
            description:
              "Découvrez si Annette peut vous accompagner."
          };
        }

        if (imc >= 35) {
          return {
            classKey: "class-2",
            classIndex: 2,
            badge: "Obésité de classe II",
            title:
              "Perdre du poids peut contribuer à réduire certains risques.",
            description:
              "Découvrez si Annette peut vous accompagner."
          };
        }

        return {
          classKey: "class-1",
          classIndex: 1,
          badge: "Obésité de classe I",
          title:
            "Perdre du poids peut contribuer à améliorer votre santé.",
          description:
            "Découvrez si Annette peut vous accompagner."
        };
      }

      function renderCircleIndicator(
        displayedImc,
        classKey,
        classIndex
      ) {
        return (
          '<div class="imc-circle-indicator" aria-label="IMC estimé : ' +
            displayedImc +
          '">' +

            '<svg viewBox="0 0 120 120" aria-hidden="true">' +

              '<circle class="imc-circle-track" cx="60" cy="60" r="47"></circle>' +

              '<circle ' +
                'class="imc-circle-segment ' +
                  (classIndex === 1
                    ? "active " + classKey
                    : "") +
                '" ' +
                'cx="60" cy="60" r="47" ' +
                'stroke-dasharray="82 213" ' +
                'stroke-dashoffset="0">' +
              "</circle>" +

              '<circle ' +
                'class="imc-circle-segment ' +
                  (classIndex === 2
                    ? "active " + classKey
                    : "") +
                '" ' +
                'cx="60" cy="60" r="47" ' +
                'stroke-dasharray="82 213" ' +
                'stroke-dashoffset="-98">' +
              "</circle>" +

              '<circle ' +
                'class="imc-circle-segment ' +
                  (classIndex === 3
                    ? "active " + classKey
                    : "") +
                '" ' +
                'cx="60" cy="60" r="47" ' +
                'stroke-dasharray="82 213" ' +
                'stroke-dashoffset="-196">' +
              "</circle>" +

            "</svg>" +

            '<div class="imc-circle-center">' +
              '<span class="imc-result-label">IMC estimé</span>' +
              '<strong class="imc-result-value">' +
                displayedImc +
              "</strong>" +
              '<span class="imc-result-unit">kg/m²</span>' +
            "</div>" +

          "</div>"
        );
      }

      function renderBenefits() {
        return (
          '<div class="imc-benefits-box">' +

            '<div class="imc-benefit">' +
              '<span class="imc-benefit-icon" aria-hidden="true">' +
                '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
                  '<circle cx="12" cy="12" r="9"></circle>' +
                  '<path d="M12 8v8M8 12h8"></path>' +
                "</svg>" +
              "</span>" +

              "<p>Médecins partenaires indépendants</p>" +
            "</div>" +

            '<div class="imc-benefit">' +
              '<span class="imc-benefit-icon" aria-hidden="true">' +
                '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
                  '<path d="M12 20.5C6.8 16.6 4 13.7 4 9.9A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 8 1.9c0 3.8-2.8 6.7-8 10.6z"></path>' +
                "</svg>" +
              "</span>" +

              "<p>Diététicienne dédiée</p>" +
            "</div>" +

            '<div class="imc-benefit">' +
              '<span class="imc-benefit-icon" aria-hidden="true">' +
                '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
                  '<rect x="6" y="3" width="12" height="18" rx="2.5"></rect>' +
                  '<path d="M10 18h4"></path>' +
                "</svg>" +
              "</span>" +

              "<p>Application de suivi</p>" +
            "</div>" +

            '<div class="imc-benefit">' +
              '<span class="imc-benefit-icon" aria-hidden="true">' +
                '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
                  '<circle cx="9" cy="8" r="3"></circle>' +
                  '<path d="M3.5 20c0-3 2.6-5 5.5-5s5.5 2 5.5 5"></path>' +
                  '<path d="M16 5a3 3 0 0 1 0 6M15.5 15c3 .2 5 2.2 5 5"></path>' +
                "</svg>" +
              "</span>" +

              "<p>Communauté Annette</p>" +
            "</div>" +

          "</div>"
        );
      }

      function renderGoogleReviews() {
        return (
          '<div class="imc-google">' +

            '<svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true">' +
              '<path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"></path>' +
              '<path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"></path>' +
              '<path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"></path>' +
              '<path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"></path>' +
            "</svg>" +

            '<span class="imc-google-stars" aria-label="5 étoiles sur 5">' +
              "★★★★★" +
            "</span>" +

            '<span class="imc-google-text">' +
              "5/5 · Plus de 3 000 patients accompagnés" +
            "</span>" +

          "</div>"
        );
      }

      function renderResult(imc) {
        var reachesThreshold = imc >= 30;
        var displayedImc = formatImc(imc);

        if (reachesThreshold) {
          var imcData = getImcClassData(imc);

          modalContent.innerHTML =
            '<div class="imc-result-summary">' +

              renderCircleIndicator(
                displayedImc,
                imcData.classKey,
                imcData.classIndex
              ) +

              "<div>" +

                '<span class="imc-class-badge ' +
                  imcData.classKey +
                '">' +
                  imcData.badge +
                "</span>" +

                '<h2 class="imc-result-title" id="annette-imc-result-title">' +
                  imcData.title +
                "</h2>" +

                '<p class="imc-result-text">' +
                  imcData.description +
                "</p>" +

              "</div>" +

            "</div>" +

            renderBenefits() +

            renderGoogleReviews() +

            '<button class="imc-button" id="annette-imc-cta" type="button">' +
              "Commencer ma démarche →" +
            "</button>" +

            '<p class="imc-modal-reassure">' +
              "2 minutes · Gratuit · Sans engagement" +
            "</p>" +

            '<button class="imc-edit-button" id="annette-imc-edit" type="button">' +
              "Modifier mes informations" +
            "</button>" +

            '<p class="imc-disclaimer">' +
              "Calcul indicatif : il ne confirme pas votre éligibilité et ne constitue pas un diagnostic médical." +
            "</p>";

          document
            .getElementById("annette-imc-cta")
            .addEventListener("click", function () {
              var pathParts = window.location.pathname
                .split("/")
                .filter(Boolean);

              var articleSlug =
                pathParts.length > 0
                  ? pathParts[pathParts.length - 1]
                  : "page-accueil";

              if (window.dataLayer) {
                window.dataLayer.push({
                  event: "encart_cta_click",
                  encart: "calculateur_imc",
                  article_slug: articleSlug
                });
              }

              window.location.href =
                "https://app.annette.care/signup" +
                "?utm_source=article" +
                "&utm_medium=encart" +
                "&utm_campaign=calculateur_imc" +
                "&utm_content=" +
                encodeURIComponent(articleSlug);
            });
        } else {
          modalContent.innerHTML =
            '<div class="imc-result-summary">' +

              renderCircleIndicator(
                displayedImc,
                "",
                0
              ) +

              "<div>" +

                '<h2 class="imc-result-title" id="annette-imc-result-title">' +
                  "Merci d’avoir effectué le calcul." +
                "</h2>" +

                '<p class="imc-result-text">' +
                  "Le programme Annette est actuellement destiné aux adultes ayant un IMC égal ou supérieur à 30." +
                "</p>" +

              "</div>" +

            "</div>" +

            '<div class="imc-info-box">' +
              "L’IMC est un indicateur général et ne résume pas votre état de santé." +
            "</div>" +

            '<button class="imc-button" id="annette-imc-close-result" type="button">' +
              "Fermer" +
            "</button>" +

            '<button class="imc-edit-button" id="annette-imc-edit" type="button">' +
              "Modifier mes informations" +
            "</button>" +

            '<p class="imc-disclaimer">' +
              "Ce calcul est indicatif et ne constitue pas un diagnostic médical." +
            "</p>";

          document
            .getElementById("annette-imc-close-result")
            .addEventListener("click", closeModal);
        }

        document
          .getElementById("annette-imc-edit")
          .addEventListener("click", function () {
            closeModal();

            window.setTimeout(function () {
              heightInput.focus();
            }, 250);
          });

        openModal();
      }

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        clearError();

        var height = normalizeNumber(heightInput.value);
        var weight = normalizeNumber(weightInput.value);

        if (!height || !weight) {
          showError(
            "Renseignez votre taille et votre poids pour effectuer le calcul."
          );

          return;
        }

        if (height < 100 || height > 250) {
          showError(
            "Vérifiez votre taille. Elle doit être renseignée en centimètres.",
            heightInput
          );

          return;
        }

        if (weight < 30 || weight > 350) {
          showError(
            "Vérifiez votre poids. Il doit être renseigné en kilogrammes.",
            weightInput
          );

          return;
        }

        var imc = calculateImc(weight, height);
        var roundedImc = Math.round(imc * 10) / 10;

        startCalculation(roundedImc);
      });

      closeButton.addEventListener("click", closeModal);

      modal.addEventListener("click", function (event) {
        if (event.target === modal) {
          closeModal();
        }
      });

      document.addEventListener("keydown", function (event) {
        if (
          event.key === "Escape" &&
          modal.classList.contains("is-open")
        ) {
          closeModal();
        }
      });
    })();
  </script>
</div>

</body>
</html>
